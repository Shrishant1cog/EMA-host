EMA_ENV=development
# Local / development
BACKEND_URL=http://127.0.0.1:8000
SESSION_TTL_SECONDS=604800
SESSION_SECURE_COOKIE=false
TOKEN_ENCRYPTION_REQUIRED=false

# AI
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=high
AI_VERIFIER_ENABLED=true
AI_VERIFIER_MODEL=openai/gpt-oss-20b
AI_VERIFIER_REASONING_EFFORT=high
AI_MAX_COMPLETION_TOKENS=5000
AI_VERIFIER_MAX_COMPLETION_TOKENS=3000
AI_EVIDENCE_HINTS_ENABLED=true

# Admin
EMA_ADMIN_USERNAME=replace_me
EMA_ADMIN_PASSWORD_HASH=generate_with_generate_admin_password.py
EMA_ADMIN_SESSION_TTL=28800
EMA_ADMIN_SECURE_COOKIE=false
EMA_ADMIN_MAX_LOGIN_ATTEMPTS=5
EMA_ADMIN_LOGIN_WINDOW_SECONDS=900

# Production HTTPS: use TOKEN_ENCRYPTION_REQUIRED=true, SESSION_SECURE_COOKIE=true,
# EMA_ADMIN_SECURE_COOKIE=true and provide TOKEN_ENCRYPTION_KEY.
