EMA_ENV=production

# Public deployment URLs
BACKEND_URL=https://ema-host.onrender.com
RENDER_EXTERNAL_URL=https://ema-host.onrender.com
FRONTEND_URL=https://emasys.netlify.app
REDIRECT_URI=https://ema-host.onrender.com/auth/callback

# Persistent SQLite on Render paid persistent disk
DB_PATH=/var/data/assistant.db
DATABASE_URL=sqlite:////var/data/assistant.db
STATE_DB_PATH=/var/data/assistant.db

# HTTPS / security
SESSION_SECURE_COOKIE=true
EMA_ADMIN_SECURE_COOKIE=true
TOKEN_ENCRYPTION_REQUIRED=true
TOKEN_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify
CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar

# Groq
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=high
AI_VERIFIER_ENABLED=true
AI_VERIFIER_MODEL=openai/gpt-oss-20b
AI_VERIFIER_REASONING_EFFORT=high

# Admin
EMA_ADMIN_USERNAME=
EMA_ADMIN_PASSWORD_HASH=
EMA_ADMIN_SESSION_TTL=28800
EMA_ADMIN_MAX_LOGIN_ATTEMPTS=5
EMA_ADMIN_LOGIN_WINDOW_SECONDS=900

# Runtime
POLL_INTERVAL=15
USER_TIMEZONE=Asia/Kolkata
DEFAULT_EVENT_TIME=09:00
